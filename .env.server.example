# Desk Display render server environment example.
# Copy to .env on the server host and fill in the values you need. The server
# fetches all upstream data, so every provider credential lives here and never
# on a display client. Check a file with:
#   python3 -m deployment_config check --role server --env-file .env
#
# Booleans accept 1/0, true/false, yes/no or on/off. An empty value uses the
# built-in default. Environment values are read at startup: restart the
# process after changing them (see CONFIGURATION.md for what hot-reloads).

# -----------------------------------------------------------------------------
# Deployment role and .env loading
# -----------------------------------------------------------------------------
# Deployment role: standalone (legacy single process), server, or client.
# Selects which settings are valid and how strictly startup validates them.
DESK_DISPLAY_ROLE=server
# Load .env from the project root and working directory at startup.
CONFIG_LOAD_DOTENV=1
# Process timezone for logs and system time, usually inherited from the OS.
TZ=

# -----------------------------------------------------------------------------
# Server bind address and client authentication
# -----------------------------------------------------------------------------
# Interface the render server listens on. Keep 127.0.0.1 behind a reverse
# proxy; use 0.0.0.0 only with authentication and TLS.
DESK_DISPLAY_SERVER_HOST=127.0.0.1
# TCP port for client registration, manifests and packages.
DESK_DISPLAY_SERVER_PORT=8765
# Externally reachable base URL advertised to clients, when it differs from the
# bind address (for example behind a reverse proxy).
DESK_DISPLAY_SERVER_PUBLIC_URL=
# Shared bearer token every client must present (at least 32 characters).
# Generate one with: python3 -c 'import secrets;
# print(secrets.token_urlsafe(32))' Secret: keep it out of version control.
DESK_DISPLAY_SERVER_AUTH_TOKEN=
# Bearer token for the /api/v1/admin endpoints (at least 32 characters). The
# admin API is disabled when empty. Never give it to clients. Secret: keep it
# out of version control.
DESK_DISPLAY_SERVER_ADMIN_TOKEN=
# Accept clients without a token. Only allowed while the server is bound to a
# loopback address.
DESK_DISPLAY_SERVER_ALLOW_UNAUTHENTICATED=0
# PEM certificate for serving HTTPS directly. Set together with
# DESK_DISPLAY_SERVER_TLS_KEY.
DESK_DISPLAY_SERVER_TLS_CERT=
# PEM private key for DESK_DISPLAY_SERVER_TLS_CERT.
DESK_DISPLAY_SERVER_TLS_KEY=

# -----------------------------------------------------------------------------
# Location and content timezone
# -----------------------------------------------------------------------------
# Latitude for weather, the radar map centre and default AQI/ADS-B location.
WEATHER_LATITUDE=
# Longitude for weather, the radar map centre and default AQI/ADS-B location.
WEATHER_LONGITUDE=
# IANA timezone the server renders dates, schedules and dark hours in.
DESK_DISPLAY_CONTENT_TIMEZONE=America/Chicago

# -----------------------------------------------------------------------------
# Weather providers and forecast
# -----------------------------------------------------------------------------
# Apple Developer team ID for WeatherKit.
WEATHERKIT_TEAM_ID=
# WeatherKit key ID.
WEATHERKIT_KEY_ID=
# WeatherKit service ID.
WEATHERKIT_SERVICE_ID=
# Path to the WeatherKit .p8 private key (alternative to
# WEATHERKIT_PRIVATE_KEY).
WEATHERKIT_KEY_PATH=
# Inline WeatherKit .p8 private key contents. Secret: keep it out of version
# control.
WEATHERKIT_PRIVATE_KEY=
# WeatherKit response language.
WEATHERKIT_LANGUAGE=en
# Timezone requested from WeatherKit.
WEATHERKIT_TIMEZONE=America/Chicago
# OpenWeatherMap One Call API key (fallback provider). Secret: keep it out of
# version control.
OWM_API_KEY=
# Additional OpenWeatherMap key slot; one populated slot is chosen at random.
# Secret: keep it out of version control.
OWM_API_KEY_DEFAULT=
# Additional OpenWeatherMap key slot. Secret: keep it out of version control.
OWM_API_KEY_WIFFY=
# Additional OpenWeatherMap key slot. Secret: keep it out of version control.
OWM_API_KEY_VERANO=
# OpenWeatherMap units.
OWM_UNITS=imperial
# OpenWeatherMap language.
OWM_LANGUAGE=en
# Number of hourly forecast entries shown.
HOURLY_FORECAST_HOURS=5
# Draw emoji weather symbols where supported.
WEATHER_USE_EMOJI_ICONS=0

# -----------------------------------------------------------------------------
# Outdoor air quality
# -----------------------------------------------------------------------------
# Outdoor air-quality provider.
AIR_QUALITY_PROVIDER=airnow
# Free AirNow API key (https://docs.airnowapi.org/account/request/). Secret:
# keep it out of version control.
AIRNOW_API_KEY=
# AQI latitude; defaults to WEATHER_LATITUDE. Set both AQI coordinates or
# neither.
AIR_QUALITY_LATITUDE=
# AQI longitude; defaults to WEATHER_LONGITUDE.
AIR_QUALITY_LONGITUDE=
# Include pollen data where the provider supplies it.
AIR_QUALITY_ENABLE_POLLEN=1

# -----------------------------------------------------------------------------
# Sports and teams
# -----------------------------------------------------------------------------
# NCAAM scoreboard mode.
NCAAM_SCOREBOARD_MODE=top25
# Optional JSON override for NHL break windows (All-Star, Olympics).
NHL_BREAK_WINDOWS_JSON=
# NHL schedule calendar feed (https or webcal).
NHL_SCHEDULE_ICS_URL=webcal://ics.ecal.com/ecal-sub/6a5e38cbff3cfc0002c15087/NHL.ics
# What pregame World Cup score columns show.
WORLD_CUP_PREGAME_SCORE_DISPLAY=dash
# Hold time for each team standings page.
TEAM_STANDINGS_DISPLAY_SECONDS=5
# MLB scoreboard scroll delay; defaults to the profile's scoreboard scroll
# delay.
MLB_SCOREBOARD_SCROLL_DELAY=
# Bottom padding below scoreboard standings rows, in pixels.
SCOREBOARD_STANDINGS_BOTTOM_PADDING=30
# Result flag height for MLB schedule screens.
SMALL_RESULT_FLAG_H=48
# Nixie clock format.
NIXIE_TIME_FORMAT=12
# HockeyTech feed base URL for the AHL/Chicago Wolves.
AHL_API_BASE_URL=https://lscluster.hockeytech.com/feed/
# HockeyTech API key; AHL requests are skipped when empty. Secret: keep it out
# of version control.
AHL_API_KEY=
# HockeyTech client code.
AHL_CLIENT_CODE=ahl
# HockeyTech league ID.
AHL_LEAGUE_ID=4
# HockeyTech site ID.
AHL_SITE_ID=1
# HockeyTech season ID; detected automatically when empty.
AHL_SEASON_ID=
# Private StanzaCal (or compatible https/webcal) ICS URL for the Wolves
# schedule. Secret: keep it out of version control.
AHL_SCHEDULE_ICS_URL=
# HockeyTech team ID.
AHL_TEAM_ID=624
# AHL team tricode.
AHL_TEAM_TRICODE=CHI
# AHL team name.
AHL_TEAM_NAME=Chicago Wolves

# -----------------------------------------------------------------------------
# News, stocks, and On This Day
# -----------------------------------------------------------------------------
# Enable the news headlines screen.
ENABLE_NEWS_HEADLINES=1
# Enable the independently configured second news screen.
ENABLE_NEWS_HEADLINES_2=1
# News feed topics file; defaults to news_feeds.json. Its contents hot-reload.
NEWS_FEEDS_CONFIG_PATH=
# Second news screen's feed file; defaults to news_feeds_2.json. Its contents
# hot-reload.
NEWS_FEEDS_CONFIG_PATH_2=
# On-screen time for the news ticker.
NEWS_HEADLINES_DISPLAY_SECONDS=30
# Fetch and draw headline thumbnails.
NEWS_HEADLINES_SHOW_IMAGES=1
# Base ticker scroll speed in pixels per frame.
NEWS_TICKER_BASE_SPEED=2.3
# Timeout for fetching an article opened from the ticker.
NEWS_ARTICLE_FETCH_TIMEOUT_SECONDS=6
# Append the stock quote row to the news ticker.
ENABLE_STOCK_TICKER=1
# Stock quote cache lifetime.
STOCK_TICKER_CACHE_TTL_SECONDS=900
# Time budget for building the On This Day feed.
ON_THIS_DAY_FEED_BUILD_TIMEOUT_SECONDS=3.5
# Retry interval after an incomplete Wikimedia response.
ON_THIS_DAY_INCOMPLETE_FEED_RETRY_SECONDS=300
# Retry interval after every On This Day feed fails.
ON_THIS_DAY_OFFLINE_FALLBACK_RETRY_SECONDS=900
# Download live Wikimedia thumbnails.
ON_THIS_DAY_LIVE_THUMBNAILS=0
# User agent sent to Wikimedia; include your own contact URL when
# redistributing.
WIKIMEDIA_USER_AGENT=DeskDisplay/1.0 (https://github.com/mrjrask/desk_display)

# -----------------------------------------------------------------------------
# ADS-B receiver stats
# -----------------------------------------------------------------------------
# Host or IP of the first dump1090-fa receiver.
ADSB_DEVICE_1_HOST=
# Label for receiver 1.
ADSB_DEVICE_1_LABEL=
# Optional second receiver; leave empty for one receiver.
ADSB_DEVICE_2_HOST=
# Label for receiver 2.
ADSB_DEVICE_2_LABEL=
# Receiver site latitude for distances; defaults to WEATHER_LATITUDE.
ADSB_HOME_LATITUDE=
# Receiver site longitude; defaults to WEATHER_LONGITUDE.
ADSB_HOME_LONGITUDE=
# Distance unit shown on screen.
ADSB_DISTANCE_UNIT=nm
# How often the collector polls each receiver.
ADSB_POLL_INTERVAL_SECONDS=10
# Collector HTTP timeout per request.
ADSB_REQUEST_TIMEOUT_SECONDS=5
# Days of raw sightings kept before pruning.
ADSB_RETENTION_DAYS=7
# SQLite database path; defaults to cache/adsb_stats.db.
ADSB_DB_PATH=
# Download the aircraft type database for type lookups.
ADSB_TYPE_DB_ENABLED=1
# Aircraft type database download URL.
ADSB_TYPE_DB_URL=https://raw.githubusercontent.com/wiedehopf/tar1090-db/csv/aircraft.csv.gz
# Aircraft type database path; defaults to cache/aircraft_types.db.
ADSB_TYPE_DB_PATH=
# Days between aircraft type database refreshes.
ADSB_TYPE_DB_REFRESH_DAYS=30

# -----------------------------------------------------------------------------
# Maps and travel
# -----------------------------------------------------------------------------
# The weather radar map is centred on WEATHER_LATITUDE and WEATHER_LONGITUDE,
# and its tile and radar endpoints are built in. No map or travel-route
# provider credential is read by this release, so there is nothing else to set
# here.

# -----------------------------------------------------------------------------
# Screen configuration, styles, and layouts
# -----------------------------------------------------------------------------
# Screen schedule/playlist file; defaults to screens_config.json. Its contents
# hot-reload.
SCREENS_CONFIG_PATH=
# Local screen-config override file layered over SCREENS_CONFIG_PATH.
SCREENS_CONFIG_LOCAL_PATH=
# Screen style overrides; defaults to screens_style.json. Its contents
# hot-reload.
SCREENS_STYLE_PATH=
# Quad screen layouts; defaults to screens_layouts.json. Its contents
# hot-reload.
SCREENS_LAYOUTS_PATH=
# Default screen bundle used by the config UI; defaults to
# default_screens_large.json.
DEFAULT_SCREENS_PATH=
# Large-display default bundle; defaults to DEFAULT_SCREENS_PATH.
DEFAULT_SCREENS_LARGE_PATH=
# Small-display default bundle; defaults to default_screens_small.json.
DEFAULT_SCREENS_SMALL_PATH=
# Server-managed playlist library and per-client assignments, written by the
# config UI; defaults to .runtime/server/playlists.json. Its contents
# hot-reload.
DESK_DISPLAY_PLAYLIST_STORE_PATH=

# -----------------------------------------------------------------------------
# Refresh intervals and upstream requests
# -----------------------------------------------------------------------------
# Weather refresh interval.
WEATHER_REFRESH_SECONDS=1800
# How long startup waits for critical feeds before rendering.
STARTUP_CRITICAL_FEED_TIMEOUT_SECONDS=8
# Back-off after an upstream answers 403 Forbidden.
HTTP_CLIENT_FORBIDDEN_COOLDOWN_SECONDS=300
# Honour HTTP(S)_PROXY and system proxy settings for outgoing requests.
HTTP_CLIENT_USE_SYSTEM_PROXIES=0

# -----------------------------------------------------------------------------
# Render workers
# -----------------------------------------------------------------------------
# Parallel render workers; each renders one (screen, profile) artifact at a
# time.
DESK_DISPLAY_RENDER_WORKERS=2
# Abandon a single artifact render after this long.
DESK_DISPLAY_RENDER_TIMEOUT_SECONDS=30

# -----------------------------------------------------------------------------
# Artifact storage
# -----------------------------------------------------------------------------
# Directory for rendered artifacts and packages; defaults to cache/artifacts.
DESK_DISPLAY_ARTIFACT_DIR=
# Delete artifacts no manifest has referenced for this long.
DESK_DISPLAY_ARTIFACT_RETENTION_HOURS=24
# Upper bound for the artifact store; the oldest unreferenced artifacts go
# first.
DESK_DISPLAY_ARTIFACT_MAX_MB=512

# -----------------------------------------------------------------------------
# Client leases and static clients
# -----------------------------------------------------------------------------
# Client registry snapshot the render server writes for the config UI; defaults
# to .runtime/server/clients.json. Contains no credentials.
DESK_DISPLAY_CLIENT_REGISTRY_PATH=
# How long a client registration stays active without a heartbeat.
DESK_DISPLAY_CLIENT_LEASE_SECONDS=300
# Clients pre-registered at startup, as comma-separated client_id:profile
# pairs, so their artifacts render before they first connect.
DESK_DISPLAY_STATIC_CLIENTS=

# -----------------------------------------------------------------------------
# Configuration UI
# -----------------------------------------------------------------------------
# Config UI bind address.
SCREEN_CONFIG_HOST=0.0.0.0
# Config UI port.
SCREEN_CONFIG_PORT=5002
# Optional login username.
SCREEN_UI_USERNAME=
# Password required for UI pages and APIs when set. Secret: keep it out of
# version control.
SCREEN_UI_PASSWORD=
# Dedicated Flask session-signing secret; otherwise derived from the password
# or a per-process random value. Secret: keep it out of version control.
SCREEN_SESSION_SECRET=
# Force authentication on; startup fails when SCREEN_UI_PASSWORD is empty.
SCREEN_AUTH_ENABLED=0

# -----------------------------------------------------------------------------
# Screenshot feed server
# -----------------------------------------------------------------------------
# Screenshot feed server bind address.
FEED_SERVER_HOST=0.0.0.0
# Screenshot feed server port.
FEED_SERVER_PORT=5003
# Where uploaded screenshots are kept; defaults to feed_uploads/.
FEED_STORAGE_DIR=
# Largest accepted screenshot upload.
FEED_MAX_UPLOAD_BYTES=8388608
# Mark a feed source stale after this long without uploads.
FEED_STALE_SECONDS=120
# Mark a source's heartbeat stale after this long.
FEED_HEARTBEAT_STALE_SECONDS=600
# Hide a screen's screenshot from the Feed page after this long.
FEED_SCREEN_STALE_SECONDS=1200

# -----------------------------------------------------------------------------
# Server caches and history files
# -----------------------------------------------------------------------------
# Pressure trend history; defaults to cache/pressure_history.json.
PRESSURE_HISTORY_PATH=
# Weather chart history; defaults to cache/weather_metric_history.json.
WEATHER_METRIC_HISTORY_PATH=
# Air-quality history; defaults to cache/air_quality_history.json.
AIR_QUALITY_HISTORY_PATH=
# Daily On This Day cache; defaults to the application cache directory.
ON_THIS_DAY_CACHE_PATH=

# -----------------------------------------------------------------------------
# Screenshots and feed upload
# -----------------------------------------------------------------------------
# Shared upload token; the feed server rejects uploads without it. Secret: keep
# it out of version control.
FEED_UPLOAD_TOKEN=

# -----------------------------------------------------------------------------
# Logs
# -----------------------------------------------------------------------------
# Log level for the display, config UI and feed server processes.
DESK_DISPLAY_LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Diagnostics
# -----------------------------------------------------------------------------
# Periodic garbage-collection interval.
DESK_DISPLAY_GC_INTERVAL_SECONDS=30
# Control file for diagnostic single-screen playback from the config UI.
DESK_DISPLAY_DIAGNOSTIC_CONTROL_PATH=
# Resolver options reported in NHL diagnostics.
RES_OPTIONS=
# Resolver search domain reported in diagnostics.
LOCALDOMAIN=
# Resolver host aliases file reported in diagnostics.
HOSTALIASES=
