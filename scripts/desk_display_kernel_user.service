[Unit]
Description=Desk Display Kernel (User Session)
After=graphical-session.target

[Service]
Type=simple
WorkingDirectory=@PROJECT_DIR@
Environment=CONFIG_LOAD_DOTENV=1
EnvironmentFile=-@PROJECT_DIR@/.env
Environment=DESK_DISPLAY_OUTPUT=kernel
ExecStartPre=/bin/bash -lc '@PROJECT_DIR@/scripts/wait_for_display_ready.sh'
ExecStart=@VENV_DIR@/bin/python @PROJECT_DIR@/main.py
ExecStop=/bin/bash -lc '@MAINTENANCE_DIR@/cleanup.sh'
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
