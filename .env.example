# Desk Display environment example
# Copy this file to .env and fill in local secrets/paths as needed.
# Boolean values generally accept 1/0, true/false, yes/no, or on/off.

# -----------------------------------------------------------------------------
# .env loading
# -----------------------------------------------------------------------------
# Load .env automatically at startup. Defaults to enabled unless set to 0.
CONFIG_LOAD_DOTENV=1

# -----------------------------------------------------------------------------
# Core display and rendering
# -----------------------------------------------------------------------------
# Output mode selects the renderer/hardware backend. Valid values and aliases:
#   auto: prefer an exact framebuffer match, otherwise try Display HAT Mini, then
#     framebuffer fallback, then headless.
#   displayhatmini (aliases: display-hat-mini, hatmini, hat): Pimoroni
#     Display HAT Mini hardware.
#   minipitft (aliases: mini-pitft, adafruit-minipitft, pitft): Adafruit
#     miniPiTFT 1.14" ST7789 hardware.
#   kernel (aliases: kms, drm, sdl, fullscreen): fullscreen SDL/KMS/DRM output;
#     falls back to framebuffer when unavailable.
#   window (aliases: windowed, macos_window, mac-window, sdl-window): SDL window;
#     runs headless if a window cannot be opened.
#   framebuffer (aliases: fb, framebuffer-device): direct Linux framebuffer output.
#   headless (aliases: none, off): render without opening display hardware.
DESK_DISPLAY_OUTPUT=auto
# Display profile controls layout/scaling defaults. It is normally auto-detected from
# DISPLAY_WIDTH and DISPLAY_HEIGHT; use the matching dimensions below to select one:
#   display_hat_mini: 320x240 or 240x320
#   adafruit_minipitft_114: 240x135 or 135x240
#   hyperpixel4_square: 720x720
#   hyperpixel4: 800x480 or 480x800
#   hdmi_1080p: 1920x1080 or 1080x1920
#   fallback_hd: any >=1280x720-ish widescreen layout (16:10 or wider)
#   fallback_default: any other resolution
DESK_DISPLAY_PROFILE=
# Low-power preset toggle for launchers/configuration. Boolean values accept
# 1/0, true/false, yes/no, or on/off. When enabled by a launcher, prefer smaller
# window scale and disable optional screenshot/video/Wi-Fi monitor work.
DESK_DISPLAY_LOW_POWER=0
# Force headless behavior even if DESK_DISPLAY_OUTPUT requests display hardware.
DESK_DISPLAY_FORCE_HEADLESS=0
# Render resolution. Also drives auto-detected display profile when no hardware
# profile is implied by the active output.
DISPLAY_WIDTH=800
DISPLAY_HEIGHT=480
# Accepts degrees (0, 90, 180, 270) or quarter turns (0, 1, 2, 3).
DISPLAY_ROTATION=0
# Strictly guard against double rotation when kernel overlays already rotate.
DISPLAY_ROTATION_STRICT=1
# Framebuffer options for direct framebuffer output.
# DISPLAY_FB_DEVICE defaults to /dev/fb0.
DISPLAY_FB_DEVICE=/dev/fb0
# DISPLAY_FB_PIXEL_FORMAT overrides auto-detection, commonly rgb565, rgb888,
# bgr888, xrgb8888, xbgr8888, argb8888, abgr8888, rgba8888, or bgra8888.
DISPLAY_FB_PIXEL_FORMAT=
# DISPLAY_FB_PIXEL_ORDER overrides channel order when needed; usually rgb or bgr.
DISPLAY_FB_PIXEL_ORDER=
# Hide the Linux console cursor / switch the console to graphics mode in
# framebuffer output. Boolean values accept 1/0, true/false, yes/no, or on/off.
DISPLAY_FB_HIDE_CONSOLE_CURSOR=1
DISPLAY_FB_CONSOLE_GRAPHICS=1
# HyperPixel/display profile hints. HYPERPIXEL_PANEL currently recognizes
# hyperpixel4 to normalize 480x800 portrait dimensions to 800x480 landscape.
HYPERPIXEL_PANEL=
HYPERPIXEL_LED_INDICATOR_BORDER_ENABLED=1
HYPERPIXEL_LED_INDICATOR_BORDER_WIDTH=2
# Display HAT Mini behavior.
# DISPLAY_HAT_MINI_LED_ENABLED and DISPLAY_HAT_MINI_LED_INDICATOR_BORDER_ENABLED
# are booleans. DISPLAY_HAT_MINI_LED_LEVEL accepts the driver-supported LED
# brightness value; leave empty for the default. DISPLAY_HAT_MINI_REINIT_SECONDS
# is a non-negative interval; 0 disables periodic reinitialization.
DISPLAY_HAT_MINI_LED_ENABLED=1
DISPLAY_HAT_MINI_LED_LEVEL=
DISPLAY_HAT_MINI_LED_INDICATOR_BORDER_ENABLED=1
DISPLAY_HAT_MINI_REINIT_SECONDS=1800
# Fade-in steps by display family; use 0 to disable a family-specific fade.
DISPLAY_FADE_IN_ENABLED=1
DISPLAY_FADE_IN_DISPLAY_HAT_MINI_STEPS=10
DISPLAY_FADE_IN_HYPERPIXEL_STEPS=0
DISPLAY_FADE_IN_HDMI_1080P_STEPS=0

# -----------------------------------------------------------------------------
# SDL/window/session output
# -----------------------------------------------------------------------------
DESK_DISPLAY_WINDOW_SCALE=1
DESK_DISPLAY_WINDOW_RESIZABLE=0
DESK_DISPLAY_SDL_FULLSCREEN=0
DESK_DISPLAY_SDL_DRIVERS=
SDL_VIDEODRIVER=
DESK_DISPLAY_SESSION_USER=
# Usually inherited from the desktop/session; set only when launching manually.
DISPLAY=
WAYLAND_DISPLAY=
XAUTHORITY=
XDG_RUNTIME_DIR=

# -----------------------------------------------------------------------------
# miniPiTFT and hardware buttons
# -----------------------------------------------------------------------------
MINIPITFT_BAUDRATE=64000000
MINIPITFT_DRIVER_ROTATION=90
MINIPITFT_DRIVER_WIDTH=135
MINIPITFT_DRIVER_HEIGHT=240
MINIPITFT_X_OFFSET=53
MINIPITFT_Y_OFFSET=40
# Optional GPIO pin overrides for hardware buttons.
BUTTON_A=
BUTTON_B=
BUTTON_X=
BUTTON_Y=
DESK_DISPLAY_RPI_GPIO_FALLBACK=1

# -----------------------------------------------------------------------------
# Runtime behavior and interaction
# -----------------------------------------------------------------------------
ENABLE_SCREENSHOTS=1
ENABLE_VIDEO=0
ENABLE_WIFI_MONITOR=1
ENABLE_WIFI_RECOVERY=1
SCREEN_CONFIG_AUTOSTART=1
STARTUP_CRITICAL_FEED_TIMEOUT_SECONDS=8
DESK_DISPLAY_GC_INTERVAL_SECONDS=30
TOUCH_DOUBLE_TAP_MAX_INTERVAL_SECONDS=0.45
ESC_DOUBLE_PRESS_ACTION=stop
ESC_DOUBLE_PRESS_MAX_INTERVAL_SECONDS=1.0
DARK_HOURS=
TEAM_STANDINGS_DISPLAY_SECONDS=5
HTTP_CLIENT_USE_SYSTEM_PROXIES=0
IP_WITH_TIME=1

# -----------------------------------------------------------------------------
# Paths and config files
# -----------------------------------------------------------------------------
SCREENS_CONFIG_PATH=
SCREENS_CONFIG_LOCAL_PATH=
SCREENS_STYLE_PATH=
SCREENS_LAYOUTS_PATH=
SCREENSHOT_DIR=
SCREENSHOT_ARCHIVE_BASE=
PRESSURE_HISTORY_PATH=pressure_history.json

# -----------------------------------------------------------------------------
# Config UI and auth
# -----------------------------------------------------------------------------
SCREEN_CONFIG_HOST=0.0.0.0
SCREEN_CONFIG_PORT=5002
# Optional username for the login form.
SCREEN_UI_USERNAME=
# Set a password to require login for UI pages and API endpoints.
SCREEN_UI_PASSWORD=
# Force auth middleware on even when password is empty.
SCREEN_AUTH_ENABLED=0

# -----------------------------------------------------------------------------
# Weather location and display
# -----------------------------------------------------------------------------
WEATHER_LATITUDE=
WEATHER_LONGITUDE=
WEATHER_REFRESH_SECONDS=1800
HOURLY_FORECAST_HOURS=5
WEATHER_USE_EMOJI_ICONS=0

# -----------------------------------------------------------------------------
# Outdoor air quality
# -----------------------------------------------------------------------------
# AQI defaults to WEATHER_LATITUDE / WEATHER_LONGITUDE. Set both values to use
# a different fixed AQI location; they are sent directly to AirNow and are
# never inferred from a city name or a weather/map response. AirNow provides
# U.S. EPA monitoring data for the United States and requires a free API key:
# https://docs.airnowapi.org/account/request/
AIR_QUALITY_LATITUDE=
AIR_QUALITY_LONGITUDE=
AIRNOW_API_KEY=

# -----------------------------------------------------------------------------
# Apple WeatherKit credentials
# -----------------------------------------------------------------------------
WEATHERKIT_TEAM_ID=
WEATHERKIT_KEY_ID=
WEATHERKIT_SERVICE_ID=
WEATHERKIT_KEY_PATH=
WEATHERKIT_PRIVATE_KEY=
WEATHERKIT_LANGUAGE=en
WEATHERKIT_TIMEZONE=America/Chicago

# -----------------------------------------------------------------------------
# OpenWeatherMap fallback weather
# -----------------------------------------------------------------------------
OWM_API_KEY=
OWM_API_KEY_DEFAULT=
OWM_API_KEY_WIFFY=
OWM_API_KEY_VERANO=
OWM_UNITS=imperial
OWM_LANGUAGE=en

# -----------------------------------------------------------------------------
# World Cup scoreboard
# -----------------------------------------------------------------------------
# Pregame score columns show a dash by default. Set to abbreviation to show each
# team's 3-letter abbreviation in the same font size as the game-time line.
# Accepted abbreviation values: abbreviation, abbr, abbrev, team, team_abbreviation.
WORLD_CUP_PREGAME_SCORE_DISPLAY=dash

# -----------------------------------------------------------------------------
# Indoor sensors
# -----------------------------------------------------------------------------
# Optional override of auto-detect. One of: pim_sensor_stick, pimoroni_bme280,
# adafruit_bme280, pimoroni_bme680, pimoroni_bme68x, adafruit_bme680,
# adafruit_sht41.
INSIDE_SENSOR=
# Backward-compatible alias for INSIDE_SENSOR.
INDOOR_SENSOR=
INSIDE_I2C_BUSES=1,2,10,11,13,14,15

# -----------------------------------------------------------------------------
# Sports and screen tuning
# -----------------------------------------------------------------------------
NCAAM_SCOREBOARD_MODE=top25
NHL_BREAK_WINDOWS_JSON=
NIXIE_TIME_FORMAT=12
SMALL_RESULT_FLAG_H=48

# AHL / Chicago Wolves
AHL_API_BASE_URL=https://lscluster.hockeytech.com/feed/
AHL_API_KEY=50c4cd9b5df2e390
AHL_CLIENT_CODE=ahl
AHL_LEAGUE_ID=4
AHL_SITE_ID=1
AHL_SEASON_ID=
AHL_SCHEDULE_ICS_URL=https://app.stanzacal.com/api/calendar/webcal/ahl-chicagowolves/55db9bc32a0c4b9e35d487c5/67191f4120dfd9eadf697a35.ics
AHL_TEAM_ID=624
AHL_TEAM_TRICODE=CHI
AHL_TEAM_NAME=Chicago Wolves

# -----------------------------------------------------------------------------
# Wi-Fi monitor and recovery
# -----------------------------------------------------------------------------
WIFI_INTERFACE=
WIFI_RECOVERY_LOG=
WIFI_TCP_PROBE_URLS=
WIFI_TCP_PROBE_URL=
WIFI_HTTPS_PROBE_URL=
WIFI_TCP_PROBE_HOSTS=
WIFI_TCP_PROBE_HOST=
WIFI_TCP_PROBE_PORT=443
RPI_CONNECT_CONTROL_HOST=

# DNS overrides reported in NHL diagnostics
RES_OPTIONS=
LOCALDOMAIN=
HOSTALIASES=

# -----------------------------------------------------------------------------
# Waveshare OLED LCD HAT A helper/status script
# -----------------------------------------------------------------------------
WAVESHARE_OLED_LCD_HAT_A_INSTALLED=0
WAVESHARE_OLED_MAX_VALUE_FONT_SIZE=
WAVESHARE_OLED_MAX_TIME_FONT_SIZE=
WAVESHARE_OLED_TEMP_SOURCE=weather1
WAVESHARE_OLED_TEMP_COMMAND=
WAVESHARE_OLED_TEMP_UNIT=C
WAVESHARE_OLED_WAIT_FOR_WEATHER2=1
WAVESHARE_OLED_CUBS_FINAL_STATE_PATH=/var/tmp/desk_display_cubs_final_state.json
WAVESHARE_OLED_DISPLAY_STATUS_PATH=
WAVESHARE_OLED_FONT_PATH=
WAVESHARE_OLED_LOG_LEVEL=INFO
