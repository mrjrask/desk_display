# Desk Display environment example
# Copy this file to .env and fill in local secrets/paths as needed.
# Boolean values generally accept 1/0, true/false, yes/no, or on/off.

# -----------------------------------------------------------------------------
# .env loading
# -----------------------------------------------------------------------------
# Load .env automatically at startup. Defaults to enabled unless set to 0.
CONFIG_LOAD_DOTENV=1

# -----------------------------------------------------------------------------
# Core display and rendering
# -----------------------------------------------------------------------------
# Output mode: auto, displayhatmini, minipitft, kernel, kms, drm, sdl, fullscreen,
# window, framebuffer, or headless.
DESK_DISPLAY_OUTPUT=auto
DESK_DISPLAY_FORCE_HEADLESS=0
DISPLAY_WIDTH=800
DISPLAY_HEIGHT=480
# Accepts degrees (0, 90, 180, 270) or quarter turns (0, 1, 2, 3).
DISPLAY_ROTATION=0
# Strictly guard against double rotation when kernel overlays already rotate.
DISPLAY_ROTATION_STRICT=1
# Framebuffer options for direct framebuffer output.
DISPLAY_FB_DEVICE=/dev/fb0
DISPLAY_FB_PIXEL_FORMAT=
DISPLAY_FB_PIXEL_ORDER=
# HyperPixel/display profile hints.
HYPERPIXEL_PANEL=
HYPERPIXEL_LED_INDICATOR_BORDER_ENABLED=1
HYPERPIXEL_LED_INDICATOR_BORDER_WIDTH=2
# Display HAT Mini behavior.
DISPLAY_HAT_MINI_LED_ENABLED=1
DISPLAY_HAT_MINI_LED_LEVEL=
DISPLAY_HAT_MINI_LED_INDICATOR_BORDER_ENABLED=1
DISPLAY_HAT_MINI_REINIT_SECONDS=1800
# Fade-in steps by display family.
DISPLAY_FADE_IN_ENABLED=1
DISPLAY_FADE_IN_DISPLAY_HAT_MINI_STEPS=10
DISPLAY_FADE_IN_HYPERPIXEL_STEPS=0
DISPLAY_FADE_IN_HDMI_1080P_STEPS=0

# -----------------------------------------------------------------------------
# SDL/window/session output
# -----------------------------------------------------------------------------
DESK_DISPLAY_WINDOW_SCALE=1
DESK_DISPLAY_WINDOW_RESIZABLE=0
DESK_DISPLAY_SDL_FULLSCREEN=0
DESK_DISPLAY_SDL_DRIVERS=
SDL_VIDEODRIVER=
DESK_DISPLAY_SESSION_USER=
# Usually inherited from the desktop/session; set only when launching manually.
DISPLAY=
WAYLAND_DISPLAY=
XAUTHORITY=
XDG_RUNTIME_DIR=

# -----------------------------------------------------------------------------
# miniPiTFT and hardware buttons
# -----------------------------------------------------------------------------
MINIPITFT_BAUDRATE=64000000
MINIPITFT_DRIVER_ROTATION=90
MINIPITFT_DRIVER_WIDTH=135
MINIPITFT_DRIVER_HEIGHT=240
MINIPITFT_X_OFFSET=53
MINIPITFT_Y_OFFSET=40
# Optional GPIO pin overrides for hardware buttons.
BUTTON_A=
BUTTON_B=
BUTTON_X=
BUTTON_Y=
DESK_DISPLAY_RPI_GPIO_FALLBACK=1

# -----------------------------------------------------------------------------
# Runtime behavior and interaction
# -----------------------------------------------------------------------------
ENABLE_SCREENSHOTS=1
ENABLE_VIDEO=0
ENABLE_WIFI_MONITOR=1
ENABLE_WIFI_RECOVERY=1
SCREEN_CONFIG_AUTOSTART=1
STARTUP_CRITICAL_FEED_TIMEOUT_SECONDS=8
DESK_DISPLAY_GC_INTERVAL_SECONDS=30
TOUCH_DOUBLE_TAP_MAX_INTERVAL_SECONDS=0.45
ESC_DOUBLE_PRESS_ACTION=stop
ESC_DOUBLE_PRESS_MAX_INTERVAL_SECONDS=1.0
DARK_HOURS=
TEAM_STANDINGS_DISPLAY_SECONDS=5
HTTP_CLIENT_USE_SYSTEM_PROXIES=0
IP_WITH_TIME=1

# -----------------------------------------------------------------------------
# Paths and config files
# -----------------------------------------------------------------------------
SCREENS_CONFIG_PATH=
SCREENS_CONFIG_LOCAL_PATH=
SCREENS_STYLE_PATH=
SCREENS_LAYOUTS_PATH=
SCREENSHOT_DIR=
SCREENSHOT_ARCHIVE_BASE=
PRESSURE_HISTORY_PATH=pressure_history.json

# -----------------------------------------------------------------------------
# Config UI and auth
# -----------------------------------------------------------------------------
SCREEN_CONFIG_HOST=0.0.0.0
SCREEN_CONFIG_PORT=5002
# Optional username for the login form.
SCREEN_UI_USERNAME=
# Set a password to require login for UI pages and API endpoints.
SCREEN_UI_PASSWORD=
# Force auth middleware on even when password is empty.
SCREEN_AUTH_ENABLED=0

# -----------------------------------------------------------------------------
# Weather location and display
# -----------------------------------------------------------------------------
WEATHER_LATITUDE=
WEATHER_LONGITUDE=
WEATHER_REFRESH_SECONDS=1800
HOURLY_FORECAST_HOURS=5
WEATHER_USE_EMOJI_ICONS=0

# -----------------------------------------------------------------------------
# Apple WeatherKit credentials
# -----------------------------------------------------------------------------
WEATHERKIT_TEAM_ID=
WEATHERKIT_KEY_ID=
WEATHERKIT_SERVICE_ID=
WEATHERKIT_KEY_PATH=
WEATHERKIT_PRIVATE_KEY=
WEATHERKIT_LANGUAGE=en
WEATHERKIT_TIMEZONE=America/Chicago

# -----------------------------------------------------------------------------
# OpenWeatherMap fallback weather
# -----------------------------------------------------------------------------
OWM_API_KEY=
OWM_API_KEY_DEFAULT=
OWM_API_KEY_WIFFY=
OWM_API_KEY_VERANO=
OWM_UNITS=imperial
OWM_LANGUAGE=en

# -----------------------------------------------------------------------------
# Travel time and maps
# -----------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=
TRAVEL_MODE=to_home
TRAVEL_TO_HOME_ORIGIN=
TRAVEL_TO_HOME_DESTINATION=
TRAVEL_TO_WORK_ORIGIN=
TRAVEL_TO_WORK_DESTINATION=
# Apple Maps can use a bearer token/API key or JWT signing credentials.
MAPKIT_TOKEN=
APPLE_MAPS_API_KEY=
APPLE_MAPS_TEAM_ID=
APPLE_MAPS_KEY_ID=
APPLE_MAPS_KEY_PATH=
APPLE_MAPS_PRIVATE_KEY=
APPLE_MAPS_DIRECTIONS_URL=https://maps-api.apple.com/v1/directions
APPLE_MAPS_SNAPSHOT_URL=https://maps-api.apple.com/v1/snapshot

# -----------------------------------------------------------------------------
# Indoor sensors
# -----------------------------------------------------------------------------
# Optional override of auto-detect. One of: pim_sensor_stick, pimoroni_bme280,
# adafruit_bme280, pimoroni_bme680, pimoroni_bme68x, adafruit_bme680,
# adafruit_sht41.
INSIDE_SENSOR=
# Backward-compatible alias for INSIDE_SENSOR.
INDOOR_SENSOR=
INSIDE_I2C_BUSES=1,2,10,11,13,14,15

# -----------------------------------------------------------------------------
# Sports and screen tuning
# -----------------------------------------------------------------------------
NCAAM_SCOREBOARD_MODE=top25
NHL_BREAK_WINDOWS_JSON=
NIXIE_TIME_FORMAT=12
SMALL_RESULT_FLAG_H=48

# AHL / Chicago Wolves
AHL_API_BASE_URL=https://lscluster.hockeytech.com/feed/
AHL_API_KEY=50c4cd9b5df2e390
AHL_CLIENT_CODE=ahl
AHL_LEAGUE_ID=4
AHL_SITE_ID=1
AHL_SEASON_ID=
AHL_SCHEDULE_ICS_URL=https://app.stanzacal.com/api/calendar/webcal/ahl-chicagowolves/55db9bc32a0c4b9e35d487c5/67191f4120dfd9eadf697a35.ics
AHL_TEAM_ID=624
AHL_TEAM_TRICODE=CHI
AHL_TEAM_NAME=Chicago Wolves

# -----------------------------------------------------------------------------
# Wi-Fi monitor and recovery
# -----------------------------------------------------------------------------
WIFI_INTERFACE=
WIFI_RECOVERY_LOG=
WIFI_TCP_PROBE_URLS=
WIFI_TCP_PROBE_URL=
WIFI_HTTPS_PROBE_URL=
WIFI_TCP_PROBE_HOSTS=
WIFI_TCP_PROBE_HOST=
WIFI_TCP_PROBE_PORT=443
RPI_CONNECT_CONTROL_HOST=

# DNS overrides reported in NHL diagnostics
RES_OPTIONS=
LOCALDOMAIN=
HOSTALIASES=

# -----------------------------------------------------------------------------
# Waveshare OLED LCD HAT A helper/status script
# -----------------------------------------------------------------------------
WAVESHARE_OLED_LCD_HAT_A_INSTALLED=0
WAVESHARE_OLED_MAX_VALUE_FONT_SIZE=
WAVESHARE_OLED_MAX_TIME_FONT_SIZE=
WAVESHARE_OLED_TEMP_SOURCE=weather1
WAVESHARE_OLED_TEMP_COMMAND=
WAVESHARE_OLED_TEMP_UNIT=C
WAVESHARE_OLED_WAIT_FOR_WEATHER2=1
WAVESHARE_OLED_CUBS_FINAL_STATE_PATH=/var/tmp/desk_display_cubs_final_state.json
WAVESHARE_OLED_DISPLAY_STATUS_PATH=
WAVESHARE_OLED_FONT_PATH=
WAVESHARE_OLED_LOG_LEVEL=INFO
