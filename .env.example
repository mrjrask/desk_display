# Load .env automatically when CONFIG_LOAD_DOTENV=1
CONFIG_LOAD_DOTENV=1

# Paths and rendering flags
SCREENS_STYLE_PATH=
STYLE_CONFIG_PATH=
ENABLE_SCREENSHOTS=1
ENABLE_VIDEO=0
ENABLE_WIFI_MONITOR=1
DESK_DISPLAY_FORCE_HEADLESS=0
ADMIN_DISABLE_AUTO_RENDER=0
ADMIN_HOST=0.0.0.0
ADMIN_PORT=5001
ADMIN_DEBUG=0
FLASK_DEBUG=0

# Authentication and access
ADMIN_API_TOKEN=
# Screen configuration web UI auth (http://localhost:5002)
# Optional username for login form.
SCREEN_UI_USERNAME=
# Set a password to require login for UI pages and API endpoints.
SCREEN_UI_PASSWORD=
# Optional: force auth middleware on even when password is empty.
SCREEN_AUTH_ENABLED=0
HTTP_CLIENT_USE_SYSTEM_PROXIES=0

# WeatherKit credentials
WEATHERKIT_TEAM_ID=
WEATHERKIT_KEY_ID=
WEATHERKIT_SERVICE_ID=
WEATHERKIT_KEY_PATH=
WEATHERKIT_PRIVATE_KEY=
WEATHERKIT_LANGUAGE=en
WEATHERKIT_TIMEZONE=America/Chicago
WEATHER_REFRESH_SECONDS=1800
HOURLY_FORECAST_HOURS=5

# Travel time and maps
GOOGLE_MAPS_API_KEY=
TRAVEL_TO_HOME_ORIGIN=
TRAVEL_TO_HOME_DESTINATION=
TRAVEL_TO_WORK_ORIGIN=
TRAVEL_TO_WORK_DESTINATION=

# Indoor sensors (optional override of auto-detect)
# One of: pim_sensor_stick, pimoroni_bme280, adafruit_bme280,
# pimoroni_bme680, pimoroni_bme68x, adafruit_bme680,
# adafruit_sht41
INSIDE_SENSOR=
# Optional I2C bus override for Pimoroni Multi-Sensor Stick
# (LTR559 + LSM6DS3 screen widgets). Example: 10
PIM_SENSOR_STICK_I2C_BUS=

# Display configuration
DISPLAY_ROTATION=0
# Low-power/HyperPixel Pi Zero frame pacing (leave blank for defaults).
DESK_DISPLAY_PROFILE=
DESK_DISPLAY_LOW_POWER=
DISPLAY_TARGET_FPS=
DISPLAY_SCROLL_TARGET_FPS=
DISPLAY_ANIMATION_TARGET_FPS=
DARK_HOURS=
TEAM_STANDINGS_DISPLAY_SECONDS=5

# AirPlay receiver (optional)
# PIN code used by AirPlay clients when pairing with desk_display receiver.
AIRPLAY_PAIRING_CODE=
# Receiver name shown to iOS/macOS devices.
AIRPLAY_NAME=Desk Display AirPlay
# Force receiver resolution (leave blank to auto-detect from connected display).
AIRPLAY_RESOLUTION=
# Optional display target for AirPlay renderer, for example :0.0 or wayland-0.
AIRPLAY_DISPLAY=
# Optional passthrough args for uxplay (advanced).
AIRPLAY_EXTRA_ARGS=

# NHL/AHL settings
AHL_API_BASE_URL=https://lscluster.hockeytech.com/feed/
AHL_API_KEY=50c4cd9b5df2e390
AHL_CLIENT_CODE=ahl
AHL_LEAGUE_ID=4
AHL_SITE_ID=1
AHL_SEASON_ID=
AHL_SCHEDULE_ICS_URL=
AHL_TEAM_ID=624
AHL_TEAM_TRICODE=CHI
AHL_TEAM_NAME=Chicago Wolves

# Olympic medals
OLYMPIC_MEDALS_URL=https://www.espn.com/olympics/winter/2026/medals

# MLB screen tuning
SMALL_RESULT_FLAG_H=48

# Wi-Fi recovery
WIFI_RECOVERY_LOG=
WIFI_INTERFACE=

# DNS overrides reported in NHL diagnostics
RES_OPTIONS=
LOCALDOMAIN=
HOSTALIASES=
