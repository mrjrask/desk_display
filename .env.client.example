# Desk Display display-client environment example.
# Copy to .env on each display. A client needs only its identity, the server
# URL and token, and its own hardware settings: never an upstream API key or
# provider URL. Check a file with:
#   python3 -m deployment_config check --role client --env-file .env
#
# Booleans accept 1/0, true/false, yes/no or on/off. An empty value uses the
# built-in default. Environment values are read at startup: restart the
# process after changing them (see CONFIGURATION.md for what hot-reloads).

# -----------------------------------------------------------------------------
# Deployment role and .env loading
# -----------------------------------------------------------------------------
# Deployment role: standalone (legacy single process), server, or client.
# Selects which settings are valid and how strictly startup validates them.
DESK_DISPLAY_ROLE=client
# Load .env from the project root and working directory at startup.
CONFIG_LOAD_DOTENV=1
# Process timezone for logs and system time, usually inherited from the OS.
TZ=

# -----------------------------------------------------------------------------
# Client identity
# -----------------------------------------------------------------------------
# Stable, unique ID for this display (letters, digits, '.', '_' or '-', up to
# 64 characters). Keep it across reinstalls so the server keeps its playlist.
DESK_DISPLAY_CLIENT_ID=office-display
# Optional human-readable name shown in the server UI; defaults to the client
# ID.
DESK_DISPLAY_CLIENT_NAME=

# -----------------------------------------------------------------------------
# Server URL and client authentication
# -----------------------------------------------------------------------------
# Base URL of the render server.
DESK_DISPLAY_SERVER_URL=https://desk-display.lan:8765
# Bearer token matching the server's DESK_DISPLAY_SERVER_AUTH_TOKEN. Secret:
# keep it out of version control.
DESK_DISPLAY_CLIENT_TOKEN=
# CA bundle used to verify a server certificate from a private CA.
DESK_DISPLAY_SERVER_CA_BUNDLE=
# Verify the server's TLS certificate.
DESK_DISPLAY_TLS_VERIFY=1
# Permit plain HTTP to a non-loopback server, or TLS without verification, on a
# trusted network. Startup then warns instead of failing.
DESK_DISPLAY_ALLOW_INSECURE_TRANSPORT=0

# -----------------------------------------------------------------------------
# Refresh intervals and upstream requests
# -----------------------------------------------------------------------------
# Honour HTTP(S)_PROXY and system proxy settings for outgoing requests.
HTTP_CLIENT_USE_SYSTEM_PROXIES=0

# -----------------------------------------------------------------------------
# Display profile and render size
# -----------------------------------------------------------------------------
# Display profile: display_hat_mini, adafruit_minipitft_114, hyperpixel4,
# hyperpixel4_square, waveshare_lcd_320x240, waveshare_oled_128x64, hdmi_1080p,
# fallback_hd or fallback_default. Required on clients; standalone detects it
# from DISPLAY_WIDTH/DISPLAY_HEIGHT when empty.
DESK_DISPLAY_PROFILE=hyperpixel4
# Render width in pixels.
DISPLAY_WIDTH=800
# Render height in pixels.
DISPLAY_HEIGHT=480
# HyperPixel panel hint; hyperpixel4 normalizes 480x800 to 800x480.
HYPERPIXEL_PANEL=
# Low-power preset: fewer radar frames and no optional screenshot/video/Wi-Fi
# work. Auto-enabled on Pi Zero boards; set 0 to force off.
DESK_DISPLAY_LOW_POWER=

# -----------------------------------------------------------------------------
# Output driver
# -----------------------------------------------------------------------------
# Output driver: auto, displayhatmini, minipitft, kernel, window, framebuffer
# or headless (aliases accepted).
DESK_DISPLAY_OUTPUT=auto
# Force headless output regardless of DESK_DISPLAY_OUTPUT.
DESK_DISPLAY_FORCE_HEADLESS=0
# Fade new frames in where supported.
DISPLAY_FADE_IN_ENABLED=1
# Fade-in steps on Display HAT Mini; 0 disables.
DISPLAY_FADE_IN_DISPLAY_HAT_MINI_STEPS=10
# Fade-in steps on HyperPixel; 0 disables.
DISPLAY_FADE_IN_HYPERPIXEL_STEPS=0
# Fade-in steps on HDMI 1080p; 0 disables.
DISPLAY_FADE_IN_HDMI_1080P_STEPS=0

# -----------------------------------------------------------------------------
# Physical rotation
# -----------------------------------------------------------------------------
# Physical rotation applied at presentation: 0, 90, 180 or 270 degrees, or 0-3
# quarter turns.
DISPLAY_ROTATION=0
# Reject invalid rotations and avoid double rotation when a kernel overlay
# already rotates.
DISPLAY_ROTATION_STRICT=1

# -----------------------------------------------------------------------------
# Framebuffer and panel hardware
# -----------------------------------------------------------------------------
# Framebuffer device.
DISPLAY_FB_DEVICE=/dev/fb0
# Framebuffer pixel format override; auto-detected when empty.
DISPLAY_FB_PIXEL_FORMAT=
# Framebuffer channel order override.
DISPLAY_FB_PIXEL_ORDER=
# Hide the Linux console cursor in framebuffer mode.
DISPLAY_FB_HIDE_CONSOLE_CURSOR=1
# Switch the console to graphics mode while the framebuffer is open.
DISPLAY_FB_CONSOLE_GRAPHICS=1
# Display HAT Mini LED brightness; driver default when empty.
DISPLAY_HAT_MINI_LED_LEVEL=
# Periodic Display HAT Mini re-initialization; 0 disables (recommended).
DISPLAY_HAT_MINI_REINIT_SECONDS=0
# Exit for systemd recovery when an SPI write blocks this long; 0 disables.
DISPLAY_HAT_MINI_IO_TIMEOUT_SECONDS=15
# Consecutive refresh errors before exiting for recovery; 0 disables.
DISPLAY_HAT_MINI_MAX_REFRESH_FAILURES=3
# Drive the Display HAT Mini RGB notification LED.
LED_INDICATOR_ENABLED=1
# Draw the notification colour as a frame border on any display.
LED_INDICATOR_BORDER_ENABLED=1
# Notification border width in pixels.
LED_INDICATOR_BORDER_WIDTH=2
# miniPiTFT SPI baud rate.
MINIPITFT_BAUDRATE=64000000
# miniPiTFT driver rotation.
MINIPITFT_DRIVER_ROTATION=90
# miniPiTFT driver width.
MINIPITFT_DRIVER_WIDTH=135
# miniPiTFT driver height.
MINIPITFT_DRIVER_HEIGHT=240
# miniPiTFT X offset.
MINIPITFT_X_OFFSET=53
# miniPiTFT Y offset.
MINIPITFT_Y_OFFSET=40

# -----------------------------------------------------------------------------
# SDL window and desktop session
# -----------------------------------------------------------------------------
# SDL window scale factor.
DESK_DISPLAY_WINDOW_SCALE=1
# Allow resizing the SDL window.
DESK_DISPLAY_WINDOW_RESIZABLE=0
# Start SDL fullscreen.
DESK_DISPLAY_SDL_FULLSCREEN=0
# Comma-separated SDL video drivers to try in order.
DESK_DISPLAY_SDL_DRIVERS=
# Force a single SDL video driver.
SDL_VIDEODRIVER=
# Desktop user whose session a window/kernel output attaches to.
DESK_DISPLAY_SESSION_USER=
# X11 display, usually inherited; set only when launching manually.
DISPLAY=
# Wayland display, usually inherited.
WAYLAND_DISPLAY=
# X11 authority file, usually inherited.
XAUTHORITY=
# Session runtime directory, usually inherited.
XDG_RUNTIME_DIR=

# -----------------------------------------------------------------------------
# Local artifact cache
# -----------------------------------------------------------------------------
# Where the client keeps its manifest, playlist and packages; defaults to
# cache/client.
DESK_DISPLAY_CLIENT_CACHE_DIR=
# Upper bound for cached packages.
DESK_DISPLAY_CLIENT_CACHE_MAX_MB=256

# -----------------------------------------------------------------------------
# Synchronization and heartbeat
# -----------------------------------------------------------------------------
# How often the client checks the server for a new manifest.
DESK_DISPLAY_SYNC_INTERVAL_SECONDS=30
# How often the client reports status; keep well under the server lease.
DESK_DISPLAY_HEARTBEAT_INTERVAL_SECONDS=60

# -----------------------------------------------------------------------------
# Backlight and dark hours
# -----------------------------------------------------------------------------
# Dark-hours schedule, e.g. 'Mon-Fri 22:00-06:30; Sat-Sun 23:00-08:00'.
DARK_HOURS=
# Backlight brightness percentage outside dark hours.
DESK_DISPLAY_BACKLIGHT_LEVEL=100
# What the client does during DARK_HOURS.
DESK_DISPLAY_DARK_HOURS_MODE=off
# Backlight percentage when DESK_DISPLAY_DARK_HOURS_MODE=dim.
DESK_DISPLAY_DARK_HOURS_BACKLIGHT_LEVEL=10

# -----------------------------------------------------------------------------
# Buttons
# -----------------------------------------------------------------------------
# GPIO pin override for button A.
BUTTON_A=
# GPIO pin override for button B.
BUTTON_B=
# GPIO pin override for button X.
BUTTON_X=
# GPIO pin override for button Y.
BUTTON_Y=
# Fall back to RPi.GPIO when the preferred GPIO library is unavailable.
DESK_DISPLAY_RPI_GPIO_FALLBACK=1

# -----------------------------------------------------------------------------
# Touch and keyboard
# -----------------------------------------------------------------------------
# Whether this client has a touch panel; auto assumes one on HyperPixel
# profiles.
DESK_DISPLAY_CLIENT_TOUCH=auto
# Play render packages (scrolling, tickers, logo slides) locally; 0 shows
# stills only.
DESK_DISPLAY_CLIENT_ANIMATION=1
# Maximum gap between taps of a double tap.
TOUCH_DOUBLE_TAP_MAX_INTERVAL_SECONDS=0.45
# What a double Escape press does in window/SDL outputs.
ESC_DOUBLE_PRESS_ACTION=stop
# Maximum gap between Escape presses.
ESC_DOUBLE_PRESS_MAX_INTERVAL_SECONDS=1.0

# -----------------------------------------------------------------------------
# Offline startup
# -----------------------------------------------------------------------------
# Start from a complete, compatible local cache when the server is unreachable.
DESK_DISPLAY_OFFLINE_START=1
# Stop showing cached content older than this while offline; 0 keeps it
# indefinitely.
DESK_DISPLAY_OFFLINE_MAX_AGE_HOURS=0

# -----------------------------------------------------------------------------
# Screenshots and feed upload
# -----------------------------------------------------------------------------
# Save screenshots of presented frames.
ENABLE_SCREENSHOTS=1
# Record presented frames to video.
ENABLE_VIDEO=0
# Screenshot directory.
SCREENSHOT_DIR=
# Screenshot archive directory.
SCREENSHOT_ARCHIVE_BASE=
# Screenshot feed server URL for scripts/screenshot_uploader.py.
FEED_UPLOAD_URL=
# Shared upload token; the feed server rejects uploads without it. Secret: keep
# it out of version control.
FEED_UPLOAD_TOKEN=
# Name this display uploads under; defaults to the hostname.
FEED_SOURCE_NAME=
# Seconds between upload passes.
FEED_UPLOAD_INTERVAL_SECONDS=5
# Timeout per upload request.
FEED_UPLOAD_TIMEOUT_SECONDS=10
# Time budget for one upload pass.
FEED_UPLOAD_CYCLE_TIMEOUT_SECONDS=30
# Longest retry back-off after failed uploads.
FEED_UPLOAD_MAX_BACKOFF_SECONDS=300

# -----------------------------------------------------------------------------
# Indoor sensor
# -----------------------------------------------------------------------------
# Indoor sensor override; auto-detected when empty.
INSIDE_SENSOR=
# Backward-compatible alias for INSIDE_SENSOR.
INDOOR_SENSOR=
# I2C buses probed for the indoor sensor.
INSIDE_I2C_BUSES=1,2,10,11,13,14,15
# Indoor sensor history; defaults to cache/inside_history.json.
INSIDE_HISTORY_PATH=

# -----------------------------------------------------------------------------
# Wi-Fi monitor and recovery
# -----------------------------------------------------------------------------
# Monitor Wi-Fi connectivity.
ENABLE_WIFI_MONITOR=1
# Attempt Wi-Fi recovery after sustained loss.
ENABLE_WIFI_RECOVERY=1
# Wi-Fi interface; auto-detected when empty.
WIFI_INTERFACE=
# Wi-Fi recovery log file.
WIFI_RECOVERY_LOG=
# Comma-separated connectivity probe URLs.
WIFI_TCP_PROBE_URLS=
# Single connectivity probe URL.
WIFI_TCP_PROBE_URL=
# HTTPS connectivity probe URL.
WIFI_HTTPS_PROBE_URL=
# Comma-separated TCP probe hosts.
WIFI_TCP_PROBE_HOSTS=
# Single TCP probe host.
WIFI_TCP_PROBE_HOST=
# TCP probe port.
WIFI_TCP_PROBE_PORT=443
# Raspberry Pi Connect control host used for reachability checks.
RPI_CONNECT_CONTROL_HOST=

# -----------------------------------------------------------------------------
# Waveshare OLED/LCD HAT (A) status helper
# -----------------------------------------------------------------------------
# Set by the Waveshare installer; enables the HAT's layout tweaks.
WAVESHARE_OLED_LCD_HAT_A_INSTALLED=0
# OLED I2C bus.
WAVESHARE_OLED_I2C_BUS=1
# Temperature OLED I2C address.
WAVESHARE_OLED_TEMP_ADDR=0x3C
# Time OLED I2C address.
WAVESHARE_OLED_TIME_ADDR=0x3D
# OLED width.
WAVESHARE_OLED_WIDTH=128
# OLED height.
WAVESHARE_OLED_HEIGHT=64
# Smallest value font size.
WAVESHARE_OLED_MIN_VALUE_FONT_SIZE=8
# Largest value font size.
WAVESHARE_OLED_MAX_VALUE_FONT_SIZE=
# Smallest time font size; defaults to the minimum value size.
WAVESHARE_OLED_MIN_TIME_FONT_SIZE=
# Largest time font size.
WAVESHARE_OLED_MAX_TIME_FONT_SIZE=
# OLED refresh interval.
WAVESHARE_OLED_REFRESH_SECONDS=5
# Treat display status older than this as stale.
WAVESHARE_OLED_STATUS_MAX_AGE_SECONDS=300
# Minimum seconds between OLED content swaps.
WAVESHARE_OLED_SWAP_INTERVAL_MIN_SECONDS=60
# Maximum seconds between OLED content swaps.
WAVESHARE_OLED_SWAP_INTERVAL_MAX_SECONDS=240
# Fade steps between OLED frames.
WAVESHARE_OLED_FADE_STEPS=8
# Milliseconds per fade step.
WAVESHARE_OLED_FADE_STEP_MS=35
# Temperature source screen for the OLED.
WAVESHARE_OLED_TEMP_SOURCE=weather1
# Optional shell command that prints a temperature.
WAVESHARE_OLED_TEMP_COMMAND=
# OLED temperature unit.
WAVESHARE_OLED_TEMP_UNIT=C
# Wait for the weather2 screenshot before showing temperature.
WAVESHARE_OLED_WAIT_FOR_WEATHER2=1
# Cubs final-state marker file.
WAVESHARE_OLED_CUBS_FINAL_STATE_PATH=/var/tmp/desk_display_cubs_final_state.json
# Blackhawks final-state marker file.
WAVESHARE_OLED_HAWKS_FINAL_STATE_PATH=/var/tmp/desk_display_hawks_final_state.json
# Display status file the helper reads; defaults under the screenshot
# directory.
WAVESHARE_OLED_DISPLAY_STATUS_PATH=
# Screenshot directory the helper reads; defaults to SCREENSHOT_DIR.
WAVESHARE_OLED_SCREENSHOT_DIR=
# Font file for the OLEDs.
WAVESHARE_OLED_FONT_PATH=
# Helper log level.
WAVESHARE_OLED_LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Logs
# -----------------------------------------------------------------------------
# Log level for the display, config UI and feed server processes.
DESK_DISPLAY_LOG_LEVEL=INFO
# Log level for scripts/screenshot_uploader.py.
FEED_UPLOAD_LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Diagnostics
# -----------------------------------------------------------------------------
# Periodic garbage-collection interval.
DESK_DISPLAY_GC_INTERVAL_SECONDS=30
# Control file for diagnostic single-screen playback from the config UI.
DESK_DISPLAY_DIAGNOSTIC_CONTROL_PATH=
# Repeat just this screen ID instead of the normal rotation.
DESK_DISPLAY_TEST_SCREEN=
# Pause between repeats of DESK_DISPLAY_TEST_SCREEN.
DESK_DISPLAY_TEST_SCREEN_DELAY=0.5
# Resolver options reported in NHL diagnostics.
RES_OPTIONS=
# Resolver search domain reported in diagnostics.
LOCALDOMAIN=
# Resolver host aliases file reported in diagnostics.
HOSTALIASES=
